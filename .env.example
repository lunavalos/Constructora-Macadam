# ==============================================================================
# CONFIGURACIÓN SMTP PARA FORMULARIO DE CONTACTO - CONSTRUCTORA MACADAM
# ==============================================================================
# Copia este archivo como .env.local en la raíz del proyecto y completa tus credenciales.

# Servidor de correo saliente (ej: smtp.gmail.com, mail.cmacadam.com, etc.)
SMTP_HOST=smtp.tuservidor.com

# Puerto de conexión (465 para SSL, o 587 para TLS/STARTTLS)
SMTP_PORT=465

# ¿Usa conexión segura SSL directa? (true para puerto 465, false para puerto 587)
SMTP_SECURE=true

# Usuario de autenticación (generalmente tu correo completo)
SMTP_USER=contacto@cmacadam.com

# Contraseña o App Password de la cuenta de correo
SMTP_PASS=tu_contraseña_aqui

# Nombre y correo remitente que verán los destinatarios
MAIL_FROM="Constructora Macadam <contacto@cmacadam.com>"

# Correo (o correos separados por coma) que recibirá los prospectos del formulario
MAIL_TO=contacto@cmacadam.com
